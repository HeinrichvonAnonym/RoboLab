if(NOT TARGET robo_rgbd)
  message(FATAL_ERROR "RGB-D tests require ROBOLAB_BUILD_LIBREALSENSE=ON")
endif()
find_package(GTest REQUIRED)
add_executable(rgbd_test "${CMAKE_SOURCE_DIR}/tests/rgbd_test.cpp")
target_link_libraries(rgbd_test PRIVATE robo_rgbd GTest::gtest_main)
target_compile_definitions(rgbd_test PRIVATE ROBOLAB_SOURCE_DIR="${CMAKE_SOURCE_DIR}")
add_test(NAME rgbd COMMAND rgbd_test)
if(TARGET robo_rgbd_renderer)
  add_executable(rgbd_render_test "${CMAKE_SOURCE_DIR}/tests/rgbd_render_test.cpp")
  target_link_libraries(rgbd_render_test PRIVATE robo_rgbd_renderer GTest::gtest_main)
  add_test(NAME rgbd_render COMMAND rgbd_render_test)
  set_tests_properties(rgbd_render PROPERTIES LABELS "display" TIMEOUT 30)
endif()
